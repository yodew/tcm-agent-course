# Choose responses or chat explicitly. No silent protocol fallback.
TCM_MODEL_MODE=responses
TCM_MODEL_BASE_URL=https://YOUR-PROVIDER.example/v1
TCM_MODEL_NAME=YOUR-MODEL
TCM_MODEL_API_KEY=
TCM_ACCESS_TOKENS={"replace-with-a-long-random-token":"learner"}
TCM_DATABASE_URL=sqlite+aiosqlite:///./data/tcm.db
TCM_KNOWLEDGE_PATH=knowledge/entries.json
TCM_MAX_STEPS=6
TCM_TURN_TIMEOUT_SECONDS=90
TCM_MAX_OUTPUT_TOKENS=1600
TCM_RATE_LIMIT_PER_MINUTE=20
# Empty means BM25 only, never fake semantic embeddings.
TCM_EMBEDDING_MODEL=
# Set false only for providers without encrypted reasoning support, using nonreasoning models.
TCM_RESPONSES_INCLUDE_REASONING=true
# Some Chat-compatible reasoning models require max_completion_tokens.
TCM_CHAT_TOKEN_PARAMETER=max_tokens
